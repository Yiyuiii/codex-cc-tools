{
  "name": "codex-cc-tools",
  "version": "0.1.0-beta.1",
  "description": "Claude Code task tools for Codex, including review and delegated subtasks.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yiyuiii/codex-cc-tools.git"
  },
  "bugs": {
    "url": "https://github.com/Yiyuiii/codex-cc-tools/issues"
  },
  "homepage": "https://github.com/Yiyuiii/codex-cc-tools#readme",
  "bin": {
    "codex-cc-tools": "dist/index.js",
    "codex-cc-tools-mcp": "dist/mcp-server.js"
  },
  "files": [
    "dist",
    "AGENTS.md",
    "README.md",
    "README.zh-CN.md",
    "docs",
    "examples"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts src/mcp-server.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test && npm run build && node dist/index.js --version && node dist/index.js --help",
    "verify:release": "npm run typecheck && npm test && npm run release:smoke",
    "preflight": "npm ci && npm run verify:release",
    "release:smoke": "npm run build && node scripts/release-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.23.0",
    "commander": "^14.0.2",
    "execa": "^9.6.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
